---
/**
 * Home page: answers "who are you, what AI work have you done, how do I contact you"
 * in the first screen, then gives the evidence.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ProjectList from '../components/ProjectList.astro';
import { siteConfig } from '../config';
import { getSortedProjects } from '../utils/projects';

const projects = await getSortedProjects();
const featured = projects.filter((p) => p.data.featured);
const more = projects.filter((p) => !p.data.featured);
const { author, social } = siteConfig;
const initials = author.name.split(' ').map((w) => w[0]).join('');

const credentials = [
  'ISCA Fellow 2025',
  'J-PAL Invited Researcher',
  '150+ peer-reviewed papers',
  '€2M European Research Council grant',
  'Teams of up to 12 · 20+ hires',
];
---

<BaseLayout>
  <SEO slot="head" title={`${author.name} · ${author.title}`} description={siteConfig.description} type="website" noSuffix />
  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">{author.name} · {author.title}</p>
        <h1 class="hero-title">{author.headline}</h1>
        <p class="hero-pitch">{author.pitch}</p>
        <div class="hero-cta">
          <a class="btn-primary" href={`mailto:${author.email}`}>Email me</a>
          {social.linkedin && <a class="btn-secondary" href={social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
          {author.cv && <a class="btn-secondary" href={author.cv}>CV (PDF)</a>}
          <a class="text-link" href="#work">See the work ↓</a>
        </div>
      </div>
      <div class="hero-photo">
        {author.photo ? (
          <img src={author.photo} alt={`Portrait of ${author.name}`} width="280" height="280" />
        ) : (
          <div class="photo-placeholder" aria-hidden="true">{initials}</div>
        )}
        <p class="hero-location">{author.location}</p>
      </div>
    </section>

    <ul class="credentials" aria-label="Highlights">
      {credentials.map((c) => <li>{c}</li>)}
    </ul>

    <!-- FEATURED WORK -->
    <section id="work" class="section">
      <div class="section-head">
        <h2>Featured work</h2>
        <p>Each case study covers the problem, my approach, results, trade-offs and lessons, with links to the evidence.</p>
      </div>
      <div class="featured-grid">
        {featured.map((p) => {
          const metric = p.data.impact?.metrics?.[0];
          return (
            <a class="feature-card" href={`/projects/${p.id}`}>
              <span class="feature-tags">{p.data.tags.join(' · ')}</span>
              <h3>{p.data.title}</h3>
              <p class="feature-summary">{p.data.outcomeSummary}</p>
              {metric && (
                <p class="feature-metric">
                  <span class="metric-value">{metric.value}</span>
                  <span class="metric-label">{metric.label}</span>
                </p>
              )}
              <span class="feature-link">Read case study →</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- ALL PROJECTS -->
    <section class="section">
      <div class="section-head">
        <h2>More work</h2>
        <p>Filter by area. <a href="/projects">See everything on one page →</a></p>
      </div>
      <ProjectList projects={more} />
    </section>

    <!-- ABOUT + CONTACT -->
    <section class="section about-teaser">
      <div>
        <h2>About</h2>
        <p>
          Trained as a linguist in Argentina and the US, I spent 13 years at CNRS and École Normale Supérieure in Paris,
          rising to Research Director. My work has crossed linguistics, psychology, anthropology, economics and speech
          technology, recognised in both speech technology (ISCA Fellow) and development economics (J-PAL).
          I am now moving from building tools for researchers to building AI products for everyone.
        </p>
        <a class="text-link" href="/about">More about me →</a>
      </div>
      <div class="contact-box">
        <h2>Get in touch</h2>
        <p>Open to senior roles in AI/ML, responsible AI and data products.</p>
        <a class="contact-email" href={`mailto:${author.email}`}>{author.email}</a>
        <p class="contact-langs">I work in English, French and Spanish.</p>
      </div>
    </section>
  </main>

  <style>
    .home { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem 5rem; }

    .hero {
      display: grid;
      grid-template-columns: 1fr 260px;
      gap: 4rem;
      align-items: center;
      padding: 4.5rem 0 2.5rem;
    }
    .eyebrow {
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-accent);
      font-weight: 600;
      margin: 0 0 1rem;
    }
    .hero-title {
      font-size: clamp(2rem, 4.2vw, 3rem);
      line-height: 1.12;
      letter-spacing: -0.025em;
      font-weight: 700;
      margin: 0 0 1.25rem;
      max-width: 20ch;
    }
    .hero-pitch {
      font-size: 1.125rem;
      line-height: 1.65;
      color: var(--color-text-secondary);
      max-width: 58ch;
      margin: 0 0 2rem;
    }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
    .text-link { font-size: 0.9375rem; color: var(--color-text-secondary); text-decoration: none; margin-left: 0.25rem; }
    .text-link:hover { color: var(--color-accent); }

    .hero-photo { text-align: center; }
    .hero-photo img, .photo-placeholder {
      width: 240px; height: 240px; border-radius: 50%; object-fit: cover; margin: 0 auto;
    }
    .photo-placeholder {
      display: grid; place-items: center;
      background: var(--color-accent-muted);
      color: var(--color-accent);
      font-size: 4rem; font-weight: 700; letter-spacing: -0.03em;
      border: 1px solid var(--color-border);
    }
    .hero-location { margin: 0.9rem 0 0; font-size: 0.875rem; color: var(--color-text-muted); }

    .credentials {
      list-style: none; padding: 1.25rem 0; margin: 0;
      display: flex; flex-wrap: wrap; gap: 0.5rem 2rem;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      font-size: 0.875rem; color: var(--color-text-secondary);
    }
    .credentials li::before { content: "●"; color: var(--color-accent); font-size: 0.5rem; vertical-align: middle; margin-right: 0.6rem; }

    .section { padding-top: 4.5rem; scroll-margin-top: 4rem; }
    .section-head { margin-bottom: 1.75rem; }
    .section-head h2 { font-size: 1.75rem; letter-spacing: -0.015em; margin: 0 0 0.4rem; }
    .section-head p { margin: 0; color: var(--color-text-secondary); }

    .featured-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .feature-card {
      display: flex; flex-direction: column; gap: 0.75rem;
      padding: 1.5rem;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      background: var(--color-bg-secondary);
      color: var(--color-text);
      text-decoration: none;
      transition: border-color 0.15s, transform 0.15s;
    }
    .feature-card:hover { border-color: var(--color-accent); transform: translateY(-2px); }
    .feature-tags { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-text-muted); }
    .feature-card h3 { font-size: 1.1875rem; line-height: 1.3; margin: 0; }
    .feature-summary { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--color-text-secondary); flex: 1; }
    .feature-metric { margin: 0; padding-top: 0.75rem; border-top: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 0.15rem; }
    .metric-value { font-weight: 600; font-size: 0.9375rem; }
    .metric-label { font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .feature-link { font-size: 0.875rem; color: var(--color-accent); font-weight: 500; }

    .about-teaser { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: start; }
    .about-teaser h2 { font-size: 1.75rem; margin: 0 0 0.75rem; }
    .about-teaser p { color: var(--color-text-secondary); line-height: 1.7; }
    .contact-box { padding: 1.75rem; border: 1px solid var(--color-border); border-radius: 10px; }
    .contact-email { display: inline-block; font-size: 1.125rem; font-weight: 600; margin: 0.25rem 0 0.75rem; word-break: break-all; }
    .contact-langs { font-size: 0.875rem; margin: 0; }

    @media (max-width: 900px) {
      .featured-grid { grid-template-columns: 1fr; }
      .about-teaser { grid-template-columns: 1fr; }
    }
    @media (max-width: 720px) {
      .hero { grid-template-columns: 1fr; gap: 2rem; padding-top: 2.5rem; }
      .hero-photo { order: -1; text-align: left; display: flex; align-items: center; gap: 1rem; }
      .hero-photo img, .photo-placeholder { width: 88px; height: 88px; font-size: 1.75rem; margin: 0; }
      .hero-location { margin: 0; }
    }
  </style>
</BaseLayout>
